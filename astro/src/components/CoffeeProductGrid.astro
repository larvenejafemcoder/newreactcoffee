---

<section class="coffee-product-grid">
  <div class="coffee-product-grid-container">
    <div class="section-label">Curated Selection</div>
    <h2 class="section-heading">Signature <span class="heading-accent">Collection</span></h2>

    <div class="editorial-grid">
      {products.map((product) => (
        <article
          class={`product-card ${product.featured ? 'featured' : ''}`}
          style={{
            gridArea: product.gridArea,
          }}
        >
          <a href={product.link} class="product-link">
            {product.featured ? (
              <>
                <div class="featured-image">
                  <span class="card-number">{product.number}</span>
                  <img
                    src={`/media-assets/${product.image}`}
                    alt={`${product.name} ${product.subtitle}`}
                    loading="lazy"
                  />
                  <span class="roast-badge">{product.roast} Roast</span>
                </div>
                <div class="featured-content">
                  <div class="origin-line">
                    <span class="origin-badge">{product.origin}</span>
                  </div>
                  <h3 class="featured-name">
                    {product.name}
                    <span class="featured-sub">{product.subtitle}</span>
                  </h3>
                  <p class="featured-price">{product.price}</p>
                  <p class="featured-desc">{product.description}</p>
                  <div class="notes-group">
                    {product.notes.map((note) => (
                      <span class="note-tag">{note}</span>
                    ))}
                  </div>
                </div>
              </>
            ) : (
              <>
                <div class="card-image">
                  <span class="card-number-sm">{product.number}</span>
                  <img
                    src={`/media-assets/${product.image}`}
                    alt={`${product.name} ${product.subtitle}`}
                    loading="lazy"
                  />
                  <span class="roast-dot" style={{ backgroundColor: getRoastColor(product.roast) }} title={product.roast} />
                </div>
                <div class="card-content">
                  <div class="card-header">
                    <h3 class="card-name">{product.name}</h3>
                    <p class="card-sub">{product.subtitle}</p>
                  </div>
                  <p class="card-price">{product.price}</p>
                  <div class="card-overlay">
                    <div class="origin-line-small">
                      <span class="origin-badge-sm">{product.origin}</span>
                    </div>
                    <p class="card-desc">{product.description}</p>
                    <div class="notes-group-sm">
                      {product.notes.map((note) => (
                        <span class="note-tag-sm">{note}</span>
                      ))}
                    </div>
                  </div>
                </div>
              </>
            )}
          </a>
        </article>
      ))}
    </div>

    <div class="view-more-container">
      <a href="/collection" class="view-more-btn">View Full Catalog →</a>
    </div>
  </div>
</section>

